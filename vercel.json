{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci && npm --prefix client ci",
  "buildCommand": "npm run build && node scripts/prepare-vercel-public.js",
  "functions": {
    "index.js": {
      "includeFiles": ["server/**", "public/**"],
      "maxDuration": 60
    }
  }
}
